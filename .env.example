# Copy this file to .env and pick a provider. Every option is free.
#
#   mock    no key, no internet. Scripted answers, good for trying the plumbing.
#   gemini  free key from https://aistudio.google.com/apikey (no credit card).
#   ollama  a model on your own machine: install https://ollama.com then
#           run `ollama pull qwen2.5:1.5b`.
AI_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Point this at your own folder of .md or .txt files to ask about your notes.
NOTES_DIR=data/notes
